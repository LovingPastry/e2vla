<mxGraphModel adaptiveColors="auto" dx="1560" dy="1560" grid="0" page="1" pageWidth="1560" pageHeight="1560">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" value="&lt;b&gt;E2VLA 去噪网络 DiffusionHead —— 一次网络评估&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;joint7：action_dim=8，nhist=4，Ta=16，hdim=768。四种信息用三种&lt;b&gt;性质不同&lt;/b&gt;的方式注入&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fillColor=none;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="80" y="10" width="820" height="55" as="geometry"/>
    </mxCell>

    <mxCell id="in_t" value="&lt;b&gt;t&lt;/b&gt;　去噪 / 流时间&lt;br&gt;&lt;br&gt;标量，(B,)&lt;br&gt;ddim：整数 0…99&lt;br&gt;flow：head_time(t)=(1−t)×100" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="80" y="90" width="270" height="120" as="geometry"/>
    </mxCell>

    <mxCell id="in_state" value="&lt;b&gt;本体状态&lt;/b&gt;　history&lt;br&gt;&lt;br&gt;(B, 4, 8) = 4 帧 × (7 关节角 + 夹爪)&lt;br&gt;4 帧 = 3 过去 + 当前，跨 6 录制帧 ≈ 0.2 s&lt;br&gt;已经 q01/q99 归一化到 ≈[−1,1]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="380" y="90" width="330" height="120" as="geometry"/>
    </mxCell>

    <mxCell id="in_xt" value="&lt;b&gt;x_t&lt;/b&gt;　被污染的动作块&lt;br&gt;&lt;br&gt;(B, 16, 8)&lt;br&gt;第一步是纯噪声 N(0, I)&lt;br&gt;&lt;b&gt;循环里唯一真正在变的量&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="750" y="90" width="340" height="120" as="geometry"/>
    </mxCell>

    <mxCell id="in_cond" value="&lt;b&gt;cond&lt;/b&gt;　来自 ContextEncoder&lt;br&gt;&lt;br&gt;(B, 128, 768)&lt;br&gt;= 64 个 QFormer 视觉摘要&lt;br&gt;&nbsp;&nbsp;‖ 64 个 SigLIP-text 语言 token&lt;br&gt;&lt;b&gt;整个采样循环只算一次&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="1160" y="265" width="330" height="140" as="geometry"/>
    </mxCell>

    <mxCell id="enc_t" value="&lt;b&gt;denoising_time_embed&lt;/b&gt;&lt;br&gt;SinusoidalPosEmb(768) → MLP&lt;br&gt;1.18M 参数" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="80" y="265" width="270" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="enc_h" value="&lt;b&gt;hist_enc&lt;/b&gt;　Linear(&lt;b&gt;7&lt;/b&gt;→768)→LN→GELU→Linear&lt;br&gt;只吃前 7 维，&lt;b&gt;夹爪被丢弃&lt;/b&gt;（逼模型看腕部相机）&lt;br&gt;逐帧独立，帧间零交互　0.60M" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="380" y="265" width="330" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="enc_a" value="&lt;b&gt;traj_enc&lt;/b&gt;　Linear(&lt;b&gt;8&lt;/b&gt;→768)→LN→GELU→Linear&lt;br&gt;全 8 维（含夹爪，因为要预测它）&lt;br&gt;逐位置独立，位置间零交互　0.60M" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="750" y="265" width="340" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="film" value="&lt;b&gt;film&lt;/b&gt;　(B, 768)&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;不占序列位置，不是 token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="80" y="410" width="270" height="65" as="geometry"/>
    </mxCell>

    <mxCell id="cat" value="&lt;b&gt;① torch.cat(dim=1) → (B, 20, 768)&lt;/b&gt;&lt;br&gt;索引 0–3 = 历史　　索引 4–19 = 待去噪的未来动作" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="380" y="410" width="710" height="65" as="geometry"/>
    </mxCell>

    <mxCell id="pe" value="&lt;b&gt;② + traj_time_embed(arange(20))&lt;/b&gt;　　(20, 768)&lt;br&gt;无参数正弦 PE。历史与未来&lt;b&gt;共用一条连续时间轴&lt;/b&gt;，3↔4 处无跳变。只加这一次" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="380" y="520" width="710" height="65" as="geometry"/>
    </mxCell>

    <mxCell id="ditbox" value="&lt;b&gt;③ traj_context_attn = DiT × 4 层&lt;/b&gt;　（4 个独立权重的层，不是同一层循环）　37.81M" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=8;fillColor=none;strokeColor=#d6b656;strokeWidth=2;dashed=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="380" y="630" width="710" height="400" as="geometry"/>
    </mxCell>

    <mxCell id="sa" value="&lt;b&gt;self-attn&lt;/b&gt;　20 token 全连接&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;历史 ↔ 未来在这里交互；x_pe=None，&lt;b&gt;无 RoPE&lt;/b&gt;&lt;br&gt;→ +α·残差 → LayerNorm(无仿射) → &lt;b&gt;adaLN(film)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="405" y="695" width="660" height="80" as="geometry"/>
    </mxCell>

    <mxCell id="ca" value="&lt;b&gt;cross-attn&lt;/b&gt;　Q = 20 token，K/V = cond 128 token&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;value_pe=None → cond 对头部是&lt;b&gt;无序集合&lt;/b&gt;&lt;br&gt;→ +α·残差 → LayerNorm(有仿射，&lt;b&gt;不被 film 调制&lt;/b&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="405" y="800" width="660" height="80" as="geometry"/>
    </mxCell>

    <mxCell id="ffn" value="&lt;b&gt;FFN&lt;/b&gt;　768→1536→768，逐 token，无交互&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;→ +α·残差 → LayerNorm(无仿射) → &lt;b&gt;adaLN(film)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="405" y="905" width="660" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="adaln" value="&lt;b&gt;AdaLN&lt;/b&gt;　×8&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;（4 层 × 2 个，各自独立权重）&lt;br&gt;&lt;br&gt;SiLU → Linear(768→1536)&lt;br&gt;chunk → scale, shift　各 (B,1,768)&lt;br&gt;&lt;b&gt;x = x·(1+scale) + shift&lt;/b&gt;&lt;br&gt;&lt;br&gt;末层零初始化 → init 时是恒等，&lt;br&gt;网络起步对 t 完全不敏感&lt;br&gt;&lt;br&gt;9.45M（全模型 9.2%）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="80" y="700" width="270" height="215" as="geometry"/>
    </mxCell>

    <mxCell id="readout" value="&lt;b&gt;④ seq_feats[:, 4 : 20]&lt;/b&gt;　丢掉历史那 4 个 token&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;历史全程参与注意力、影响了动作 token，但&lt;b&gt;自己的输出不被监督&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;→ act_head&lt;/b&gt;　Linear(768→768)→LN→GELU→Linear(768→&lt;b&gt;8&lt;/b&gt;)，末层零初始化" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="380" y="1075" width="710" height="95" as="geometry"/>
    </mxCell>

    <mxCell id="out" value="&lt;b&gt;pred　(B, 16, 8)&lt;/b&gt;&lt;br&gt;含义由 objective 决定，&lt;b&gt;网络本身完全相同&lt;/b&gt;：&lt;br&gt;ddim → 混进去的噪声 ε　　|　　flow → 速度场 (a − noise)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="380" y="1215" width="710" height="85" as="geometry"/>
    </mxCell>

    <mxCell id="samp" value="&lt;b&gt;⑤ 采样器（在网络之外，ActionExpert 层面）&lt;/b&gt;&lt;br&gt;ddim：x ← scheduler.step(pred, t, x).prev_sample　　&lt;b&gt;20 步&lt;/b&gt;&lt;br&gt;flow：x ← x + dt · pred　　&lt;b&gt;10 步&lt;/b&gt;（Euler，无调度器）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="380" y="1345" width="710" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="note1" value="&lt;b&gt;film 是怎么作用的&lt;/b&gt;&lt;br&gt;&lt;br&gt;(B,768) → unsqueeze(1) → (B,1,768)&lt;br&gt;→ 广播到全部 20 个 token&lt;br&gt;&lt;br&gt;&lt;b&gt;历史与未来共用同一组 scale/shift&lt;/b&gt;&lt;br&gt;时间条件是均匀施加的全局量，不区分位置&lt;br&gt;&lt;br&gt;它&lt;b&gt;不参与拼接&lt;/b&gt;、不占序列长度 —— 这是它&lt;br&gt;与本体、与 x_t 的本质区别" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1160" y="630" width="330" height="200" as="geometry"/>
    </mxCell>

    <mxCell id="note2" value="&lt;b&gt;采样循环里什么在变&lt;/b&gt;&lt;br&gt;&lt;br&gt;✅ &lt;b&gt;x_t&lt;/b&gt;　每步被更新，唯一真正的变量&lt;br&gt;✅ &lt;b&gt;film&lt;/b&gt;　t 每步不同&lt;br&gt;➖ &lt;b&gt;history&lt;/b&gt;　输入不变，但 hist_enc 每步重算一遍&lt;br&gt;&nbsp;&nbsp;&nbsp;（0.6M 的 MLP × 4 token，开销可忽略）&lt;br&gt;❌ &lt;b&gt;cond&lt;/b&gt;　循环外算一次，20 步复用&lt;br&gt;&lt;br&gt;&lt;b&gt;ee_cam 动作空间下&lt;/b&gt;序列里还会多加一支&lt;br&gt;abs_pos_enc(pos_rel2abs(...))，即相机系绝对末端&lt;br&gt;位置；joint 下 has_pose_geometry=False，该模块&lt;br&gt;&lt;b&gt;根本不构建&lt;/b&gt;（从关节角复原末端位置需正运动学）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1160" y="870" width="330" height="245" as="geometry"/>
    </mxCell>

    <mxCell id="e_t" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="in_t" target="enc_t">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
