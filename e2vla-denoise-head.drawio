    <mxCell id="e_asa" value="scale/shift" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#b85450;dashed=1;fontSize=10;" edge="1" parent="1" source="adaln" target="sa">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_affn" value="scale/shift" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#b85450;dashed=1;fontSize=10;" edge="1" parent="1" source="adaln" target="ffn">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="e_s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="in_state" target="enc_h">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_x" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="in_xt" target="enc_a">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_hc" value="(B, 4, 768)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.22;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="enc_h" target="cat">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_ac" value="(B, 16, 768)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="enc_a" target="cat">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_cp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="cat" target="pe">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_pd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="pe" target="sa">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_sc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="sa" target="ca">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_cf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="ca" target="ffn">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_condca" value="K / V" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="in_cond" target="ca">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1125" y="840"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e_fr" value="(B, 20, 768)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="ffn" target="readout">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e_ro" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="readout" target="out">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
